# API keys for the experiment runners.
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# Anthropic — for Claude / Opus models
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI — for GPT-5 / GPT-4 / o1 models
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Moonshot — direct Kimi K2.6 API
# Get one at https://platform.moonshot.ai/console/api-keys
MOONSHOT_API_KEY=

# OpenRouter — fallback for any other model routed through OpenRouter
# Optional; only set if you use OpenRouter for some model
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
